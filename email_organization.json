        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst resultado = {\n  total_entrada: staticData.total_entrada || 0,\n  total_procesados: staticData.contador || 0,\n  detalle_categorias: staticData.detalle_categorias || {},\n  detalle_fuentes: staticData.detalle_fuentes || {}\n};\n\nreturn [{ json: resultado }];"
