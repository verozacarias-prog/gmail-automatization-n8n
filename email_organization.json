    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst data = items[0]?.json;\n\nconst total_entrada   = data.total_entrada || 0;\nconst total_procesados = data.total_procesados || 0;\n\nconst hay_discrepancia = total_entrada !== total_procesados;\nconst discrepancia = total_entrada - total_procesados;\n\nconst detalle_categorias = Object.entries(data.detalle_categorias || {}).map(([categoria, total]) => ({ categoria, total }));\nconst detalle_fuentes = Object.entries(data.detalle_fuentes || {}).map(([fuente, total]) => ({ fuente, total }));\n\nreturn [{\n  json: {\n    validacion: {\n      hay_discrepancia,\n      total_entrada,\n      total_procesados,\n      discrepancia,\n      explicacion: hay_discrepancia \n        ? `Se perdieron ${Math.abs(discrepancia)} emails durante el procesamiento` \n        : 'Todos los emails fueron procesados correctamente'\n    },\n    detalle_categorias,\n    detalle_fuentes,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "fef47676-2f8c-4074-8d42-e940eba39499",
      "name": "Code: Validación y Reporte",
