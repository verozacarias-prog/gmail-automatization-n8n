    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mails   = items[0].json.mails   || [];\nconst history = items[1].json.history || [];\nconst whitelist = $('Get White List').all();\n\n// Extrae solo el email de strings tipo \"Nombre <email@dominio.com>\"\nconst extractEmail = (from) => {\n  if (!from) return '';\n  const match = from.match(/<([^>]+)>/);\n  return match ? match[1].toLowerCase() : from.toLowerCase();\n};\n\n// Mapa de historial por remitente (email limpio)\nconst historyMap = {};\nfor (const h of history) {\n  const remitente = (h.remitente || '').trim().toLowerCase();\n  if (!historyMap[remitente]) historyMap[remitente] = [];\n  historyMap[remitente].push(h);\n}\n\nreturn mails.map(mail => {\n  const emailLimpio = extractEmail(mail.From);\n  return {\n    json: {\n      ...mail,\n      history_data: historyMap[emailLimpio] || [],\n      isWhitelisted: whitelist.some(w =>\n        emailLimpio.includes(w.json.Remitente?.toLowerCase())\n      )\n    }\n  };\n});"
      },
