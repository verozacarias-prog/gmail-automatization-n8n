        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f9f9f9;\">\n\n  <div style=\"background-color: #c0392b; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0;\">\n    <h2 style=\"margin: 0; font-size: 18px;\">⚠️ Discrepancia Detectada en Clasificación de Emails</h2>\n  </div>\n\n  <div style=\"background-color: white; padding: 20px; border: 1px solid #ddd; border-radius: 0 0 8px 8px;\">\n\n    <!-- RESUMEN -->\n    <div style=\"margin-bottom: 20px;\">\n      <h3 style=\"color: #2c3e50; border-bottom: 2px solid #e74c3c; padding-bottom: 5px;\">📊 Resumen de Validación</h3>\n      <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr style=\"background-color: #f2f2f2;\">\n          <td style=\"padding: 8px 12px; font-weight: bold;\">Emails que entraron</td>\n          <td style=\"padding: 8px 12px;\">{{ $json.validacion.total_entrada }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 12px; font-weight: bold;\">Emails procesados</td>\n          <td style=\"padding: 8px 12px;\">{{ $json.validacion.total_procesados }}</td>\n        </tr>\n        <tr style=\"background-color: #fdecea;\">\n          <td style=\"padding: 8px 12px; font-weight: bold; color: #c0392b;\">❌ Discrepancia</td>\n          <td style=\"padding: 8px 12px; color: #c0392b; font-weight: bold;\">{{ $json.validacion.discrepancia }} emails</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 12px; font-weight: bold;\">Explicación</td>\n          <td style=\"padding: 8px 12px;\">{{ $json.validacion.explicacion }}</td>\n        </tr>\n      </table>\n    </div>\n\n    <!-- CATEGORÍAS -->\n    <div style=\"margin-bottom: 20px;\">\n      <h3 style=\"color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px;\">🏷️ Detalle por Categoría</h3>\n      <table style=\"width: 100%; border-collapse: collapse;\">\n{{ $json.detalle_categorias.map(item => `\n<tr>\n  <td style=\"padding: 8px 12px; border-bottom: 1px solid #eee;\">${item.categoria}</td>\n  <td style=\"padding: 8px 12px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">${item.total} emails</td>\n</tr>`).join('') }}\n      </table>\n    </div>\n\n    <!-- FUENTES -->\n    <div style=\"margin-bottom: 20px;\">\n      <h3 style=\"color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px;\">📧 Detalle por Fuente</h3>\n      <table style=\"width: 100%; border-collapse: collapse;\">\n{{ $json.detalle_fuentes.map(item => `\n<tr>\n  <td style=\"padding: 8px 12px; border-bottom: 1px solid #eee; font-size: 13px;\">${item.fuente}</td>\n  <td style=\"padding: 8px 12px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">${item.total} mails</td>\n</tr>`).join('') }}\n      </table>\n    </div>\n\n    <!-- POSIBLES CAUSAS -->\n    <div style=\"background-color: #fef9e7; border-left: 4px solid #f39c12; padding: 12px 16px; margin-bottom: 20px; border-radius: 4px;\">\n      <h3 style=\"color: #e67e22; margin-top: 0;\">⚠️ Posibles Causas de Pérdida</h3>\n      <ul style=\"margin: 0; padding-left: 20px; color: #555;\">\n        <li>Errores en Size Filter</li>\n        <li>Errores en Get message details</li>\n        <li>Errores en clasificación AI</li>\n        <li>Errores en extracción de PDF</li>\n        <li>Timeouts o rate limits de Gmail</li>\n      </ul>\n    </div>\n\n    <!-- FOOTER -->\n    <div style=\"text-align: right; color: #999; font-size: 12px; border-top: 1px solid #eee; padding-top: 10px;\">\n      🕐 {{ $json.timestamp }}\n    </div>\n\n  </div>\n</div>",
        "options": {}
      },
