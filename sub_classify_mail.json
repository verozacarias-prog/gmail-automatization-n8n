    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const contentType = item.json.headers['content-type'] || '';\n const hasAttachment = contentType.toLowerCase().includes('multipart/mixed') &&\n  // verificar que haya al menos un adjunto PDF en los headers\n  JSON.stringify(item.json.headers).toLowerCase().includes('pdf');\n\n  const rawHtml = item.json.html || \"\";\n  let cleanText = rawHtml.replace(/<(style|script|head|meta|title|noscript)[^>]*>[\\s\\S]*?<\\/\\1>/gi, '');\n  cleanText = cleanText.replace(/<[^>]+>/g, ' ');\n  cleanText = cleanText.replace(/&[a-z0-9#]+;/gi, ' ');\n  cleanText = cleanText.replace(/[\\s\\u00A0\\u200B\\u200C\\u200D\\uFEFF]+/g, ' ');\n\n  const decodeHeader = (str) => {\n    if (!str) return \"\";\n    try {\n      return str.replace(/=\\?UTF-8\\?B\\?([^\\?]+)\\?=/gi, (match, p1) => Buffer.from(p1, 'base64').toString('utf8'));\n    } catch (e) { return str; }\n  };\n\n  const subject = decodeHeader(item.json.subject);\n  const from = decodeHeader(item.json.from.value[0].address);\n\n  return {\n    json: {\n      id: item.json.id,\n      from: from,\n      subject: subject,\n      body_summary: cleanText.substring(0, 2500),\n      hasAttachment: hasAttachment,\n      history_data: $('It is WhiteList?').first().json.history_data || []\n    },\n  };\n});"
      },
      "id": "20042d9e-5c3c-41e0-b7af-29f4cbe4c081",
      "name": "Clean Html body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        432
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// history_data viene inyectado por el main workflow (ya filtrado por remitente)\nconst item = $input.item;\nconst historicalData = item.json.history_data || [];\n\n// Construimos el string con los ejemplos específicos\nconst historialStr = historicalData.length > 0\n  ? historicalData.map(h => `- Categoría: ${h.categoria} | Resumen: ${h.patron} | Es Manual: ${h.is_manual}`).join('\\n')\n  : \"No hay historial previo para este remitente específico.\";\n\n// Armamos el prompt final\nconst finalPrompt = `\n### CONTEXTO DE REFERENCIA (MEMORIA) ###\n${historialStr}\n\n### DATOS DEL CORREO ACTUAL ###\n- ASUNTO: ${item.json.subject}\n- CUERPO: ${item.json.body_summary}\n- ADJUNTO (PDF): ${item.json.hasAttachment ? \"Sí, pero no descargado aún.\" : \"No tiene adjunto.\"}\n\n### TAREA ###\nAnaliza el correo actual basándote en el historial (si existe).\nSi el remitente ya fue clasificado antes, intenta mantener la coherencia. Tienen prioridad los que fueron clasificados manualmente.\nResponde siguiendo el formato JSON solicitado anteriormente.\n`;\n\nreturn {\n  json: {\n    id: item.json.id,\n    from: item.json.from,\n    subject: item.json.subject,\n    hasAttachment: item.json.hasAttachment,\n    body: item.json.body_summary,\n    ia_prompt: finalPrompt\n  }\n};"
      },
      "id": "266eef55-9b8f-41a7-8b59-bd16dd1d18c7",
      "name": "Get IA request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        432
      ]
